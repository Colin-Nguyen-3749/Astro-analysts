    "import numpy as np\n",
    "import pandas as pd\n",
    "import statsmodels.formula.api as smf\n",
    "\n",
    "# --- 1. Dates: parse, then derive features instead of using raw dates ---\n",
    "df[\"observation_date\"] = pd.to_datetime(df[\"observation_date\"], format=\"ISO8601\", utc=True)\n",
    "df[\"month\"] = df[\"observation_date\"].dt.month\n",
    "df[\"night\"] = (df[\"observation_date\"] - pd.Timedelta(hours=12)).dt.date   # grouping column\n",
    "df[\"days_since_start\"] = (df[\"observation_date\"] - df[\"observation_date\"].min()).dt.days\n",
    "\n",
    "# --- 2. Check redundancy before choosing categoricals ---\n",
    "print(df.groupby(\"telescope_id\")[[\"site_id\", \"instrument_id\"]].nunique())\n",
    "print(df[\"WCSERR\"].value_counts())   # must be 0/1; also shows the failure rate\n",
    "\n",
    "# --- 3. Select columns, drop missing rows ---\n",
    "num = [\"SATFRAC\", \"EXPTIME\", \"AIRMASS\", \"L1FWHM\", \"MOONFRAC\", \"MOONDIST\",\n",
    "       \"SKYMAG\", \"WMSHUMID\", \"WMSTEMP\", \"PIXSCALE\"]\n",
    "cat = [\"telescope_id\", \"FILTER\", \"month\"]\n",
    "\n",
    "d = df[[\"WCSERR\", \"night\", \"days_since_start\"] + cat + num].dropna().copy()\n",
    "\n",
    "# --- 4. Standardize on the copy only (df keeps raw values) ---\n",
    "d[num] = (d[num] - d[num].mean()) / d[num].std()\n",
    "\n",
    "# --- 5. Formula: no basename, no raw date, no redundant IDs ---\n",
    "formula = (\n",
    "    \"WCSERR ~ C(telescope_id) + C(FILTER) + C(month) + \"\n",
    "    \"SATFRAC + EXPTIME + AIRMASS + L1FWHM + MOONFRAC + MOONDIST + \"\n",
    "    \"SKYMAG + WMSHUMID + WMSTEMP + PIXSCALE\"\n",
    ")\n",
    "\n",
    "# --- 6. Fit with standard errors clustered by night ---\n",
    "groups = pd.factorize(d[\"night\"])[0]\n",
    "results = smf.logit(formula, data=d).fit(\n",
    "    method=\"bfgs\", maxiter=500,\n",
    "    cov_type=\"cluster\", cov_kwds={\"groups\": groups},\n",
    ")\n",
    "print(results.summary())\n",
    "\n",
    "# --- 7. Odds ratios with 95% CIs ---\n",
    "or_table = np.exp(pd.concat([results.params, results.conf_int()], axis=1))\n",
    "or_table.columns = [\"OR\", \"2.5%\", \"97.5%\"]\n",
    "or_table[\"p\"] = results.pvalues\n",
    "print(or_table.sort_values(\"p\"))"
   ]
  },
