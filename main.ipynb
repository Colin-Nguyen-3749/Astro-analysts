    "thresh = 0.3\n",
    "vals = corr.where(np.triu(np.ones(corr.shape), k=1).astype(bool)).abs()   # upper triangle only\n",
    "vals = vals.where(vals >= thresh, 0).fillna(0)\n",
    "\n",
    "def link_style(src, dst):\n",
    "    color = \"tab:red\" if corr.loc[src, dst] > 0 else \"tab:blue\"\n",
    "    return dict(color=color, alpha=0.6)\n",
    "\n",
    "circos = Circos.chord_diagram(vals, space=3, link_kws_handler=link_style)\n",
    "fig = circos.plotfig()"
