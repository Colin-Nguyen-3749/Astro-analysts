    "import matplotlib.dates as mdates\n",
    "from matplotlib.ticker import FuncFormatter\n",
    "\n",
    "ax.xaxis.set_major_locator(mdates.MonthLocator(interval=1))\n",
    "\n",
    "# Format as \"1-25\" (month without leading zero, 2-digit year)\n",
    "def short_date(x, pos=None):\n",
    "    d = mdates.num2date(x)\n",
    "    return f\"{d.month}-{d.year % 100:02d}\"\n",
    "\n",
    "ax.xaxis.set_major_formatter(FuncFormatter(short_date))\n",
    "\n",
    "plt.xticks(rotation=0)    # was 90; 0 = horizontal\n",
    "\n",
    "ax = sns.lineplot(data=result_df, x='observation_date', y='WCSERR')\n",
    "ax.xaxis.set_major_locator(mdates.MonthLocator(interval=1))\n",
    "ax.xaxis.set_major_formatter(FuncFormatter(short_date))"
   ]
