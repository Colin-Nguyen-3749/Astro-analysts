    "def failure_summary(df, by):\n",
    "    out = (\n",
    "        df.groupby(by)[\"failed\"]\n",
    "          .agg(total_images=\"count\", failures=\"sum\", failure_rate=\"mean\")\n",
    "          .sort_values(\"failure_rate\", ascending=False)\n",
    "    )\n",
    "    out[\"failure_rate\"] = (out[\"failure_rate\"] * 100).round(2)\n",
    "    return out\n",
    "\n",
    "failure_summary(lco_data, \"telescope_id\")\n",
    "failure_summary(lco_data, \"site_id\")\n",
    "failure_summary(lco_data, \"instrument_id\")  \n",
    "lco_data[\"exposure_bin\"] = pd.cut(lco_data[\"EXPTIME\"], bins=5)\n",
    "failure_summary(lco_data, \"exposure_bin\")\n",
    "failure_summary(lco_data, \"FILTER\")"
   ]
  },
