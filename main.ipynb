    "import matplotlib.pyplot as plt\n",
    "\n",
    "# --- Data prep ---\n",
    "summary = failure_summary(lco_data, \"FILTER\")          # already sorted descending, rates in %\n",
    "overall_pct = overall_rate * 100\n",
    "\n",
    "# Y-axis labels with sample sizes, e.g. \"COJ  (n = 1,583)\"\n",
    "labels = [f\"{idx}\" for idx, n in zip(summary.index, summary[\"total_images\"])]\n",
    "\n",
    "# --- Spacing controls ---\n",
    "inches_per_bar = 1.0     # <-- main control: vertical space per bar/label (increase for more room)\n",
    "bar_height = 0.55        # fraction of each slot the bar fills (smaller = bigger gaps between bars)\n",
    "label_fontsize = 10      # y-axis label size\n",
    "\n",
    "n = len(summary)\n",
    "y_pos = np.arange(n)\n",
    "fig_height = n * inches_per_bar + 3    # +1.5 covers title, x-axis label, and margins\n",
    "\n",
    "# --- Plot ---\n",
    "fig, ax = plt.subplots(figsize=(9, 4))\n",
    "\n",
    "fig.patch.set_facecolor(\"white\")   # outer figure background\n",
    "ax.set_facecolor(\"white\")          # plotting area background\n",
    "\n",
    "bars = ax.barh(labels, summary[\"failure_rate\"], color=\"#4878a8\", height=0.6, zorder=2)\n",
    "\n",
    "# Largest bar at the top (barh draws first row at the bottom by default)\n",
    "ax.invert_yaxis()\n",
    "\n",
    "# Overall line: vertical, black, dashed\n",
    "ax.axvline(overall_pct, color=\"black\", linestyle=\"--\", linewidth=1.8,\n",
    "           label=f\"Overall: {overall_pct:.2f}%\", zorder=3)\n",
    "\n",
    "# Value labels: white inside large bars, dark outside small ones\n",
    "for bar, val in zip(bars, summary[\"failure_rate\"]):\n",
    "    y = bar.get_y() + bar.get_height() / 2\n",
    "    ax.text(val + 2, y, f\"{val:.1f}%\",\n",
    "            va=\"center\", ha=\"left\",\n",
    "            color=\"#222222\", fontweight=\"bold\", fontsize=10,\n",
    "            bbox=dict(boxstyle=\"round,pad=0.25\",\n",
    "                      facecolor=\"#e0e0e0\",   # box color\n",
    "                      edgecolor=\"none\",\n",
    "                      alpha=1.0),            # 1.0 = fully opaque, hides the line\n",
    "            zorder=5)   \n",
    "    \n",
    "# --- Styling ---\n",
    "ax.set_xlim(0, summary[\"failure_rate\"].max() * 1.25)\n",
    "ax.xaxis.set_major_formatter(plt.FuncFormatter(lambda x, _: f\"{x:.0f}%\"))\n",
    "ax.set_xlabel(\"Astrometric Failure Rate (%)\")\n",
    "ax.set_ylabel(\"Type of Filter\")\n",
    "ax.set_title(\"Your Title Here\", loc=\"center\", fontsize=14, fontweight=\"bold\")\n",
    "\n",
    "# Remove horizontal gridlines; keep only faint vertical ones\n",
    "ax.grid(axis=\"y\", visible=False)\n",
    "ax.grid(axis=\"x\", color=\"#e5e5e5\", linewidth=0.8, zorder=0)\n",
    "ax.set_axisbelow(True)\n",
    "\n",
    "# Clean up frame\n",
    "ax.spines[[\"top\", \"right\"]].set_visible(False)\n",
    "\n",
    "ax.legend(loc=\"lower right\", frameon=False)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
