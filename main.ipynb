    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.dates as mdates\n",
    "import seaborn as sns\n",
    "from matplotlib.patches import Rectangle\n",
    "\n",
    "sns.set_theme(style=\"white\")\n",
    "\n",
    "result_df[\"observation_date\"] = pd.to_datetime(result_df[\"observation_date\"])\n",
    "\n",
    "# One value per day (mean across all images that night)\n",
    "daily = (result_df\n",
    "         .groupby(result_df[\"observation_date\"].dt.normalize())[\"WCSERR\"]\n",
    "         .mean())\n",
    "daily = daily.reindex(pd.date_range(daily.index.min(), daily.index.max()))  # days with no data -> NaN\n",
    "\n",
    "# Build a 7 (weekday) x n_weeks grid, weeks starting on Monday\n",
    "start = daily.index.min() - pd.Timedelta(days=daily.index.min().weekday())\n",
    "n_weeks = (daily.index.max() - start).days // 7 + 1\n",
    "grid = np.full((7, n_weeks), np.nan)\n",
    "for date, val in daily.items():\n",
    "    grid[date.weekday(), (date - start).days // 7] = val\n",
    "\n",
    "# Colormap: gray for missing days\n",
    "cmap = plt.get_cmap(\"YlOrRd\").copy()\n",
    "cmap.set_bad(\"#e6e6e6\")\n",
    "\n",
    "# Cap the color scale at the 95th percentile so a few extreme days don't wash out everything else\n",
    "vmax = np.nanpercentile(grid, 95)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(16, 3.5))\n",
    "im = ax.imshow(np.ma.masked_invalid(grid), cmap=cmap, vmin=0, vmax=vmax, aspect=\"equal\")\n",
    "\n",
    "# White gridlines between cells\n",
    "ax.set_xticks(np.arange(-.5, n_weeks, 1), minor=True)\n",
    "ax.set_yticks(np.arange(-.5, 7, 1), minor=True)\n",
    "ax.grid(which=\"minor\", color=\"white\", linewidth=1.5)\n",
    "ax.tick_params(which=\"minor\", length=0)\n",
    "\n",
    "# Weekday labels\n",
    "ax.set_yticks(range(7))\n",
    "ax.set_yticklabels([\"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\", \"Sat\", \"Sun\"])\n",
    "\n",
    "# Month labels at the week containing the 1st of each month\n",
    "month_starts = pd.date_range(daily.index.min(), daily.index.max(), freq=\"MS\")\n",
    "ax.set_xticks([(d - start).days // 7 for d in month_starts])\n",
    "ax.set_xticklabels([d.strftime(\"%b\\n%Y\") for d in month_starts])\n",
    "ax.tick_params(axis=\"both\", which=\"major\", length=0)\n",
    "\n",
    "# Outline the outlier dates\n",
    "outlier_dates = pd.to_datetime([\"2026-06-22\", \"2026-02-28\", \"2025-09-06\",\n",
    "                                \"2026-01-03\", \"2026-09-06\"])\n",
    "for date in outlier_dates:\n",
    "    col, row = (date - start).days // 7, date.weekday()\n",
    "    ax.add_patch(Rectangle((col - .5, row - .5), 1, 1, fill=False,\n",
    "                           edgecolor=\"black\", linewidth=2, zorder=5))\n",
    "\n",
    "for spine in ax.spines.values():\n",
    "    spine.set_visible(False)\n",
    "\n",
    "cbar = fig.colorbar(im, ax=ax, orientation=\"horizontal\", pad=0.25, fraction=0.05, extend=\"max\")\n",
    "cbar.set_label(\"Daily mean WCS Error (gray = no data, black outline = outlier)\")\n",
    "\n",
    "ax.set_title(\"Daily WCS Telescopic Image Failure Rates Across a Year with Notable Outliers Marked\",\n",
    "             fontsize=14, fontweight=\"bold\", pad=15)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
