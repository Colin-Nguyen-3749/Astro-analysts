   "source": [
    "#====================================================\n",
    "# Fixed Effects Logistic Regression\n",
    "# Because our data is dependent with a small number of telescopes,\n",
    "# and we have a combination of both categorical and numerical datatypes,\n",
    "# we should use Fixed Effects Logistic Regression as recommended by Google Gemini\n",
    "\n",
    "# Telescope ID is now treated as a categorical predictor (fixed effect) here,\n",
    "# which controls for all differences between the telescopes while allowing us \n",
    "# to evaluate other numerical and categorical variables. \n",
    "\n",
    "# Output:\n",
    "# Odds Ratio - tells us how much a one-unit increase in a numerical variable\n",
    "# will increase or decrease the probability of image failure\n",
    "#            - for categorical variables, this will instead be how much image\n",
    "#            - failure rates increase based on if we switch categories\n",
    "# P-values - Simply tells us if the relationship is statistically significant\n",
    "#====================================================\n",
    "\n",
    "import re\n",
    "import calendar\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import textwrap\n",
    "\n",
    "ROTATE = 0   # set to 0 to turn rotation off\n",
    "\n",
    "# Reference categories (patsy uses the first sorted level)\n",
    "ref_filter = sorted(d[\"FILTER\"].unique())[0]\n",
    "ref_telescope = sorted(d[\"telescope_id\"].unique())[0]\n",
    "ref_month = calendar.month_name[sorted(d[\"month\"].unique())[0]]\n",
    "\n",
    "# Plain-English names for the numeric predictors\n",
    "num_names = {\n",
    "    \"SATFRAC\":  \"Saturated pixel fraction\",\n",
    "    \"EXPTIME\":  \"Exposure time\",\n",
    "    \"AIRMASS\":  \"Airmass\",\n",
    "    \"L1FWHM\":   \"Seeing (FWHM)\",\n",
    "    \"MOONFRAC\": \"Moon illumination\",\n",
    "    \"MOONDIST\": \"Distance from moon\",\n",
    "    \"SKYMAG\":   \"Sky brightness\",\n",
    "    \"WMSHUMID\": \"Humidity\",\n",
    "    \"WMSTEMP\":  \"Temperature\",\n",
    "    \"PIXSCALE\": \"Pixel scale\",\n",
    "}\n",
    "\n",
    "def pretty(name):\n",
    "    if name in num_names:\n",
    "        return num_names[name]\n",
    "    m = re.match(r\"C\\(telescope_id\\)\\[T\\.(.+)\\]\", name)\n",
    "    if m:\n",
    "        return f\"Telescope {m.group(1)}\"\n",
    "    m = re.match(r\"C\\(FILTER\\)\\[T\\.(.+)\\]\", name)\n",
    "    if m:\n",
    "        return f\"Filter {m.group(1)}\"\n",
    "    m = re.match(r\"C\\(month\\)\\[T\\.(\\d+)\\]\", name)\n",
    "    if m:\n",
    "        return calendar.month_name[int(m.group(1))]\n",
    "    return name\n",
    "\n",
    "ci = results.conf_int()\n",
    "t = pd.DataFrame({\n",
    "    \"OR\": np.exp(results.params),\n",
    "    \"lo\": np.exp(ci[0]),\n",
    "    \"hi\": np.exp(ci[1]),\n",
    "    \"p\": results.pvalues,\n",
    "}).drop(\"Intercept\")\n",
    "\n",
    "def plot_forest(sub, title, ax, caption=None):\n",
    "    sub = sub.sort_values(\"OR\")\n",
    "    colors = np.where(sub[\"p\"] < 0.05, \"tab:red\", \"gray\")\n",
    "    y = np.arange(len(sub))\n",
    "    ax.hlines(y, sub[\"lo\"], sub[\"hi\"], color=colors)\n",
    "    ax.scatter(sub[\"OR\"], y, color=colors, zorder=3)\n",
    "    ax.axvline(1, color=\"black\", ls=\"--\", lw=1)\n",
    "    ax.set_xscale(\"log\")\n",
    "    ax.set_yticks(y)\n",
    "    ax.set_yticklabels([pretty(n) for n in sub.index],\n",
    "                       rotation=ROTATE, va=\"center\")\n",
    "    \n",
    "    ax.set_xlabel(\"Odds Ratio (Failures to Successes; Log Scale)\")\n",
    "    ax.set_title(title)\n",
    "\n",
    "    if caption:\n",
    "        wrapped = \"\\n\".join(textwrap.wrap(caption, width=65))\n",
    "        ax.text(0.5, -0.1, wrapped, transform=ax.transAxes,\n",
    "                ha=\"center\", va=\"top\", fontsize=12, style=\"italic\", color=\"dimgray\")\n",
    "\n",
    "num_terms = [n for n in t.index if not n.startswith(\"C(\")]\n",
    "filt_terms = [n for n in t.index if n.startswith(\"C(FILTER)\")]\n",
    "other_terms = [n for n in t.index if n.startswith(\"C(telescope\") or n.startswith(\"C(month\")]\n",
    "\n",
    "fig, axes = plt.subplots(1, 3, figsize=(20, 9))\n",
    "\n",
    "plot_forest(t.loc[num_terms], \"Distance From The Moon Is Estimated To Have \\n The Highest Odds Ratio Out Of All Numeric Predictors\", axes[0],\n",
    "            caption=\"Figure 1.\" \\\n",
    "            \"This forest plot shows the estimated Odds Ratio for each of the numeric variables in the dataset.\" \\\n",
    "            \" An Odds Ratio is calculated by dividing the number of failures by the number of successes, as opposed to the total number of \" \\\n",
    "            \"observations like with probability. A higher odds ratio shows that the variable has more failures than successes and vice versa\" \\\n",
    "            \" (with all other variables held constant). The line represent how confident we are in this estimation. Red indicates statistical significance \\n\" \\\n",
    "            \" Source: LCO Public Archive\")\n",
    "plot_forest(t.loc[filt_terms], f\"Filter I (Infrared Filters) Is Estimated To Have \\n The Highest Odds Ratio Out Of All Filter Types\", axes[1],\n",
    "            caption=\"Figure 2. \" \\\n",
    "            \"This forest plot shows the estimated Odds Ratio for each of the filter types in comparison to the reference filter Astrodon-Exo, which was chosen because it had the lowest non-zero odds-ratio.\" \\\n",
    "            \" The black dotted line indicates a log ratio of zero, which indicated no effect on failure or success. The reason why everything is in\" \\\n",
    "            \"logarithmic notation is because an odds ratio of 2 or 0.5 are equally strong, and we just care about the magnitude and direction.\" \\\n",
    "            \" Source: LCO Public Archive\")\n",
    "plot_forest(t.loc[other_terms], f\"Telescope (vs. {ref_telescope}) and month (vs. {ref_month})\", axes[2],\n",
    "            caption=\"Dots show the estimate, lines show the 95% confidence interval. \"\n",
    "                    \"Red means p < 0.05.\")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.subplots_adjust(bottom=0.22)   # make room for the captions\n",
    "plt.show()"
   ]
