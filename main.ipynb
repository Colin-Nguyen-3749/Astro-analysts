    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "ci = results.conf_int()\n",
    "t = pd.DataFrame({\n",
    "    \"OR\": np.exp(results.params),\n",
    "    \"lo\": np.exp(ci[0]),\n",
    "    \"hi\": np.exp(ci[1]),\n",
    "    \"p\": results.pvalues,\n",
    "}).drop(\"Intercept\")\n",
    "\n",
    "def plot_forest(sub, title, ax):\n",
    "    sub = sub.sort_values(\"OR\")\n",
    "    colors = np.where(sub[\"p\"] < 0.05, \"tab:red\", \"gray\")\n",
    "    y = np.arange(len(sub))\n",
    "    ax.hlines(y, sub[\"lo\"], sub[\"hi\"], color=colors)\n",
    "    ax.scatter(sub[\"OR\"], y, color=colors, zorder=3)\n",
    "    ax.axvline(1, color=\"black\", ls=\"--\", lw=1)\n",
    "    ax.set_xscale(\"log\")\n",
    "    ax.set_yticks(y)\n",
    "    ax.set_yticklabels(sub.index)\n",
    "    ax.set_xlabel(\"Odds ratio (log scale)\")\n",
    "    ax.set_title(title)\n",
    "\n",
    "num_terms = [n for n in t.index if not n.startswith(\"C(\")]\n",
    "filt_terms = [n for n in t.index if n.startswith(\"C(FILTER)\")]\n",
    "other_terms = [n for n in t.index if n.startswith(\"C(telescope\") or n.startswith(\"C(month\")]\n",
    "\n",
    "fig, axes = plt.subplots(1, 3, figsize=(20, 8))\n",
    "plot_forest(t.loc[num_terms], \"Numeric predictors (per 1 SD)\", axes[0])\n",
    "plot_forest(t.loc[filt_terms], \"Filter (vs. reference filter)\", axes[1])\n",
    "plot_forest(t.loc[other_terms], \"Telescope and month (vs. reference)\", axes[2])\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
