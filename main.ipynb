    "from matplotlib.ticker import FuncFormatter, LogLocator\n",
    "\n",
    "def plot_forest(sub, title, ax):\n",
    "    sub = sub.sort_values(\"OR\")\n",
    "    colors = np.where(sub[\"p\"] < 0.05, \"tab:red\", \"gray\")\n",
    "    y = np.arange(len(sub))\n",
    "    ax.hlines(y, sub[\"lo\"], sub[\"hi\"], color=colors)\n",
    "    ax.scatter(sub[\"OR\"], y, color=colors, zorder=3)\n",
    "    ax.axvline(1, color=\"black\", ls=\"--\", lw=1)\n",
    "    ax.set_xscale(\"log\")\n",
    "    ax.set_yticks(y)\n",
    "    ax.set_yticklabels([pretty(n) for n in sub.index],\n",
    "                       rotation=ROTATE, va=\"center\")\n",
    "    ax.set_xlabel(\"Odds ratio (log scale)\")\n",
    "    ax.set_title(title)\n",
    "\n",
    "    # Readable x-axis: plain numbers, fewer ticks, rotated\n",
    "    ax.xaxis.set_major_locator(LogLocator(base=10, numticks=8))\n",
    "    ax.xaxis.set_major_formatter(FuncFormatter(lambda v, _: f\"{v:g}\"))\n",
    "    ax.xaxis.set_minor_formatter(FuncFormatter(lambda v, _: \"\"))\n",
    "    ax.tick_params(axis=\"x\", labelrotation=45)\n",
    "    for lbl in ax.get_xticklabels():\n",
    "        lbl.set_ha(\"right\")"
   ]
